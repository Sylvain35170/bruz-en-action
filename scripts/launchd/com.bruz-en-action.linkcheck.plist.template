<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bruz-en-action.linkcheck</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec __VENV_PYTHON__ __REPO__/scripts/agents/agent_qa.py --links-only</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/bruz-en-action-linkcheck.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/bruz-en-action-linkcheck.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
